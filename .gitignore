# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
.env
.venv/

# Patch scripts (temp tools, not part of release)
fix*.py
analyze_images.py
auto_slice.py
extract_ui_blocks.py
remove_bg.py
unpack_assets.py
unpack_batch.py

# Editor / IDE — local, not versioned
.vscode/
.idea/
*.swp
*.swo

# Claude Code — local config/skills, not versioned
.claude/

# Kilo — config/outillage local non versionné, SAUF les plans : ils portent
# le raisonnement derrière des choix encore en place, et une IA travaillant
# sur un clone frais ne les verrait pas s'ils restaient ignorés.
.kilo/*
!.kilo/plans/

# Cache de fraîcheur du cliquet des conventions (F2-T1) : empreinte mtime
# locale, régénérée à chaque build. À ne pas confondre avec
# `.standards-baseline.json`, qui est la base de référence et se commite.
.standards-source-freshness
.standards-source-freshness.counts
.standards-source-freshness.info

# Superpowers working docs (specs/plans/audits) — local, not versioned
docs/superpowers/

# Local API keys / launch scripts — secrets, never version
glm.sh
*.token
*_secret.sh

# Logs
*.log

# Build Outputs / Release Zips
.build/
bundles/
StarHubFR.app/
StarHubTH.app/
mods/*/README.md
*.xnb

# Generated SourceKit-LSP compile database
compile_commands.json
mods tests/

# Espace de travail des exécutions de plan (superpowers SDD) — scratch, jamais versionné
.superpowers/

# Canevas Claude Design assemblé (généré par seed-canvas.mjs) — les sources
# versionnées sont les .dc.html et canvas.json
design/starhubfr-design-system.html
