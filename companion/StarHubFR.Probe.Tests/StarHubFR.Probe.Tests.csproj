<Project Sdk="Microsoft.NET.Sdk">
  <!--
    D5-A : tests hors jeu de GuidedRule.cs, inclus par lien. Pas de
    ProjectReference : elle tirerait ModBuildConfig et le chemin du jeu.
    Hors de companion/StarHubFR.Probe/ : le SDK compilerait sinon ces
    tests dans le mod. La CI ne le lance pas (dotnet absent du runner).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../StarHubFR.Probe/GuidedRule.cs" Link="GuidedRule.cs" />
    <Compile Include="../StarHubFR.Probe/LoadRecord.cs" Link="LoadRecord.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
</Project>
